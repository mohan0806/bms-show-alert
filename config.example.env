# ===================================================================
#  BMS Show Alert settings
#  1. Copy this file to config.env   (cp config.example.env config.env)
#  2. Change the values after the = sign. Lines starting with # are notes.
# ===================================================================

# ---------- WHAT TO WATCH ----------

# The cinema page link from BookMyShow (README step 4 shows how to copy it).
# Watch several cinemas by separating links with a comma.
CINEMA_URL=https://in.bookmyshow.com/cinemas/hyderabad/allu-cinemas-kokapet/buytickets/ALUC/20261112

# Date(s) you want to book, as YEAR-MONTH-DAY (YYYY-MM-DD).
# Example: 12 November 2026 = 2026-11-12   (NOT 12-11-2026)
# Several dates: 2026-11-12,2026-11-13
DATES=2026-11-12

# Movie name. Part of the name is enough, capitals don't matter.
MOVIE=Ramayana

# Language. Leave empty to accept any language. Several: Telugu,Hindi
LANGUAGE=Telugu

# Format, spelled exactly as BookMyShow shows it (run: python bms_watch.py --list).
# Examples: 2D, 3D, IMAX 3D, DOLBY CINEMA 3D, 4DX 3D. Leave empty for any format.
FORMAT=DOLBY CINEMA 3D

# ---------- HOW OFTEN ----------

# Seconds between checks. Minimum 60. 120-300 is a good choice.
CHECK_EVERY_SECONDS=150

# Random +/- seconds added to each wait, so checks don't look robotic.
JITTER_SECONDS=20

# ---------- ALARM (this is what wakes you up) ----------

# Loud alarm on the phone (Android/Termux) or spoken alert (Mac): true or false
PHONE_ALARM=true
# How many times the alarm repeats (about 6 seconds each)
ALARM_ROUNDS=15

# ---------- TELEGRAM MESSAGE (optional) ----------

# Leave both empty if you don't want Telegram. If set, you also get the showtimes
# and booking link as a message, plus a daily "still running" message.
# Bot token from @BotFather. Keep it secret, never share or upload it.
TELEGRAM_BOT_TOKEN=
# Your chat ID number
TELEGRAM_CHAT_ID=

# ---------- EXTRAS ----------

# Message you once when the date opens but your movie/format isn't listed yet
NOTIFY_WHEN_DATE_OPENS=true

# Daily "still running" Telegram message after this hour (0-23, India time). Empty = off.
HEARTBEAT_HOUR=9

# Warn (phone notification, plus Telegram if set up) after this many failed checks in a row
FAIL_ALERT_AFTER=5

# Stop watching after the first alert (true) or keep watching for new shows (false)
STOP_AFTER_FOUND=false

# How the page is loaded: chromium (recommended), auto, or plain
FETCH_MODE=chromium
# Only if Chromium/Chrome isn't found automatically
CHROMIUM_PATH=
